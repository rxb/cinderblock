{
  "name": "cinderblock",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync-templates": "node scripts/sync-templates.js",
    "test-cli": "npm run sync-templates && node scripts/test-cli.js",
    "dev:starter": "cd packages/starter-nextjs-default && npm run dev",
    "dev:kitchensink": "cd packages/starter-nextjs-kitchensink && npm run dev",
    "dev:cli": "npm run sync-templates && cd packages/create-cinderblock-app && npm link"
  },
  "overrides": {
    "react-native-media-query": {
      "react-native-web": "^0.21.0"
    },
    "next-mdx-remote": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    }
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.1.1"
  }
}
